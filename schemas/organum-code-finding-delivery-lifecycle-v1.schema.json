{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organum.dev/schemas/organum-code-finding-delivery-lifecycle-v1.schema.json",
  "$comment": "Structural projection. The Zod source and its cross-field refinements remain authoritative.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "organum-code/finding-delivery-lifecycle/v1"
    },
    "producer_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "target": {
      "type": "object",
      "properties": {
        "lane_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,254}[A-Za-z0-9])?$"
        }
      },
      "required": [
        "lane_id",
        "actor_id"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "incomplete_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "terminal_unobserved",
            "ambiguous_transport_match",
            "producer_state_incomplete"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "maxItems": 65536,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "finding_registered"
              },
              "finding_id": {
                "type": "string",
                "pattern": "^h-runaway-[0-9a-f]{64}$"
              },
              "finding_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "registration_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "seq",
              "kind",
              "finding_id",
              "finding_sha256",
              "registration_sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "semantic_input"
              },
              "finding_id": {
                "type": "string",
                "pattern": "^h-runaway-[0-9a-f]{64}$"
              },
              "finding_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "registration_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "turn_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,254}[A-Za-z0-9])?$"
              },
              "transport_event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,254}[A-Za-z0-9])?$"
              },
              "input_packet_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "surface": {
                "type": "string",
                "const": "provider_semantic_input"
              }
            },
            "required": [
              "seq",
              "kind",
              "finding_id",
              "finding_sha256",
              "registration_sha256",
              "turn_id",
              "transport_event_id",
              "input_packet_sha256",
              "surface"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "target_terminal"
              },
              "terminal_state": {
                "type": "string",
                "enum": [
                  "completed",
                  "failed",
                  "cancelled",
                  "deadline_exceeded",
                  "blocked_on_human_input"
                ]
              }
            },
            "required": [
              "seq",
              "kind",
              "terminal_state"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schema",
    "producer_revision",
    "run_id",
    "target",
    "status",
    "incomplete_reason",
    "events",
    "finalized_at"
  ],
  "additionalProperties": false
}
