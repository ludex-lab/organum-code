{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organum.dev/schemas/organum-code-finding-delivery-cast-binding-v1.schema.json",
  "$comment": "Structural projection. The Zod source and its cross-field refinements remain authoritative.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "organum-code/finding-delivery-cast-binding/v1"
    },
    "producer_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preregistration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract": {
      "type": "object",
      "properties": {
        "registration_schema": {
          "type": "string",
          "const": "organum-code/finding-delivery-registration/v1"
        },
        "receipt_schema": {
          "type": "string",
          "const": "organum-code/finding-delivery-receipt/v1"
        },
        "lifecycle_schema": {
          "type": "string",
          "const": "organum-code/finding-delivery-lifecycle/v1"
        }
      },
      "required": [
        "registration_schema",
        "receipt_schema",
        "lifecycle_schema"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "organum_coordination",
            "bare_no_coordination"
          ]
        },
        "route_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      },
      "required": [
        "channel",
        "route_id"
      ],
      "additionalProperties": false
    },
    "registrations": {
      "maxItems": 65536,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,1022}[A-Za-z0-9])?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "finding_id": {
            "type": "string",
            "pattern": "^h-runaway-[0-9a-f]{64}$"
          },
          "lane_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "path",
          "sha256",
          "finding_id",
          "lane_id"
        ],
        "additionalProperties": false
      }
    },
    "receipts": {
      "maxItems": 65536,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,1022}[A-Za-z0-9])?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "finding_id": {
            "type": "string",
            "pattern": "^h-runaway-[0-9a-f]{64}$"
          },
          "lane_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "path",
          "sha256",
          "finding_id",
          "lane_id"
        ],
        "additionalProperties": false
      }
    },
    "lifecycles": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))(?!.*\\/\\/)[A-Za-z0-9](?:[A-Za-z0-9._/-]{0,1022}[A-Za-z0-9])?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lane_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "path",
          "sha256",
          "lane_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "producer_revision",
    "run_id",
    "manifest_sha256",
    "preregistration_sha256",
    "contract",
    "route",
    "registrations",
    "receipts",
    "lifecycles"
  ],
  "additionalProperties": false
}
