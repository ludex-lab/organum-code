{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organum.dev/schemas/organum-code-native-tool-capability-v1.schema.json",
  "$comment": "Structural projection. The Zod source and its cross-field refinements remain authoritative.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "organum-code/native-tool-capability/v1"
    },
    "path": {
      "type": "object",
      "properties": {
        "backendId": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "backendVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]{0,126}[A-Za-z0-9])?$"
        },
        "productSurface": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,510}[A-Za-z0-9])?$"
        },
        "launchMode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,510}[A-Za-z0-9])?$"
        },
        "platform": {
          "type": "string",
          "enum": [
            "darwin",
            "linux",
            "win32"
          ]
        },
        "platformVersion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]{0,126}[A-Za-z0-9])?$"
        }
      },
      "required": [
        "backendId",
        "backendVersion",
        "productSurface",
        "launchMode",
        "platform",
        "platformVersion"
      ],
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,510}[A-Za-z0-9])?$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "providerCalls": {
          "type": "number",
          "const": 0
        },
        "argumentCanonicalization": {
          "type": "string",
          "const": "organum-code/rfc8785-json-arguments/v1"
        },
        "policy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:@/-]{0,510}[A-Za-z0-9])?$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._+-]{0,126}[A-Za-z0-9])?$"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "sourceRevision",
        "providerCalls",
        "argumentCanonicalization",
        "policy"
      ],
