{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organum.dev/schemas/organum-code-harness-provenance-v1.schema.json",
  "$comment": "Structural projection. The Zod source and its cross-field refinements remain authoritative.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "organum-code/harness-provenance/v1"
    },
    "treatment": {
      "type": "string",
      "const": "same upstream model × Organum-Code-brokered native body"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "organum-code"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "version",
        "commit"
      ],
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "opencode",
            "claude",
            "grok",
            "deepcode",
            "codex"
          ]
        },
        "binary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "id",
        "binary",
        "version"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "protocol": {
          "type": "string",
          "enum": [
            "chat-completions",
            "responses"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "implementer",
            "reviewer",
            "critic",
            "researcher"
          ]
        },
        "secretSource": {
          "type": "string",
          "enum": [
            "environment",
            "dotenv",
            "keychain"
          ]
        }
      },
      "required": [
        "name",
        "provider",
        "model",
        "protocol",
        "role",
        "secretSource"
      ],
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "boolean"
        },
        "coordination": {
          "type": "boolean"
        },
        "firstPartyPlugin": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "submittedArguments": {
          "type": "object",
          "properties": {
            "visibility": {
              "type": "string",
              "const": "sha256-only"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "visibility",
            "count",
            "sha256"
          ],
          "additionalProperties": false
        },
        "bindingSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "actor",
        "coordination",
        "firstPartyPlugin",
        "submittedArguments",
        "bindingSha256"
      ],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "same-clean-synthetic-git-fixture",
            "unspecified"
          ]
        },
        "fixtureSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "caller-supplied",
            "unavailable"
          ]
        }
      },
      "required": [
        "policy",
        "fixtureSha256",
        "source"
      ],
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "chat-completions",
            "responses",
            "responses-to-chat-completions",
            "messages",
            "messages-to-chat-completions"
          ]
        },
        "mediation": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "auxiliaryRequests": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "mediation",
        "auxiliaryRequests"
      ],
      "additionalProperties": false
    },
    "visibility": {
      "type": "object",
      "properties": {
        "vendorInternalPrompt": {
          "type": "string",
          "const": "vendor-internal-opaque"
        },
        "outboundRequest": {
          "type": "string",
          "const": "observable-provider-request"
        },
        "rawPromptPersisted": {
          "type": "boolean",
          "const": false
        },
        "rawSystemPersisted": {
          "type": "boolean",
          "const": false
        },
        "rawToolDescriptionsPersisted": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "vendorInternalPrompt",
        "outboundRequest",
        "rawPromptPersisted",
        "rawSystemPersisted",
        "rawToolDescriptionsPersisted"
      ],
      "additionalProperties": false
    },
    "requests": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ordinal": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "upstreamRoute": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "requestClass": {
            "type": "string",
            "enum": [
              "tool-capable",
              "tool-result-followup",
              "text-only"
            ]
          },
          "body": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "utf8Bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sha256",
              "utf8Bytes"
            ],
            "additionalProperties": false
          },
          "system": {
            "type": "object",
            "properties": {
              "visibility": {
                "type": "string",
                "enum": [
                  "observable-provider-request",
                  "absent-at-observed-boundary"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "utf8Bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "visibility",
              "count",
              "sha256",
              "utf8Bytes"
            ],
            "additionalProperties": false
          },
          "tools": {
            "type": "object",
            "properties": {
              "visibility": {
                "type": "string",
                "enum": [
                  "observable-provider-request",
                  "absent-at-observed-boundary"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "utf8Bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "names": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "canonicalSchemaSha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "visibility",
              "count",
              "sha256",
              "utf8Bytes",
              "names",
              "canonicalSchemaSha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ordinal",
          "upstreamRoute",
          "model",
          "requestClass",
          "body",
          "system",
          "tools"
        ],
        "additionalProperties": false
      }
    },
    "settlement": {
      "type": "object",
      "properties": {
        "idle": {
          "type": "boolean"
        },
        "forcedAbortRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "admittedRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "activeRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rejectedRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "upstreamRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancelledRequests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usage": {
          "type": "object",
          "properties": {
            "responses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cachedInputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reasoningTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "responses",
            "inputTokens",
            "outputTokens",
            "totalTokens",
            "cachedInputTokens",
            "reasoningTokens"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "idle",
        "forcedAbortRequests",
        "admittedRequests",
        "activeRequests",
        "rejectedRequests",
        "upstreamRequests",
        "cancelledRequests",
        "usage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "treatment",
    "startedAt",
    "finishedAt",
    "producer",
    "backend",
    "profile",
    "launch",
    "workspace",
    "transport",
    "visibility",
    "requests",
    "settlement"
  ],
  "additionalProperties": false
}
